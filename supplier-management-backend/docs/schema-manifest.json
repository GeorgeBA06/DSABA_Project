        "contract_id": "ref:contracts",
        "state": "enum:OrderState!",
        "current_approved_version_id": "ref:order_versions",
        "created_by_id": "ref:users!",
        "created_at": "instant!",
        "updated_at": "instant!",
        "lock_version": "long!"
      },
      "pk": [
        "id"
      ],
      "unique": [
        [
          "number"
        ]
      ],
      "indexes": [
        [
          "supplier_id",
          "state"
        ],
        [
          "contract_id"
        ]
      ],
      "checks": []
    },
    "order_lines": {
      "name": "order_lines",
