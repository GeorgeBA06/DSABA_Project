      },
      "pk": [
        "id"
      ],
      "unique": [
        [
          "code"
        ]
      ],
      "indexes": [],
      "checks": []
    },
    "products": {
      "name": "products",
      "cls": "Product",
      "module": "catalog",
      "fields": {
        "id": "uuid!",
        "sku": "str:80!",
        "name": "str:250!",
        "category_id": "ref:product_categories!",
        "unit_id": "ref:units!",
        "active": "bool!",
        "created_at": "instant!",
        "updated_at": "instant!",
        "lock_version": "long!"
      },
      "pk": [
        "id"
      ],
      "unique": [
        [
          "sku"
        ]
      ],
      "indexes": [
        [
          "category_id"
        ]
      ],
      "checks": []
    },
    "suppliers": {
      "name": "suppliers",
      "cls": "Supplier",
      "module": "supplier",
      "fields": {
        "id": "uuid!",
        "name": "str:250!",
        "contact_name": "str:150",
        "email": "str:250",
        "phone": "str:60",
        "address": "text",
        "registration_number": "str:80",
        "status": "enum:SupplierStatus!",
        "created_by_id": "ref:users!",
        "created_at": "instant!",
        "updated_at": "instant!",
        "lock_version": "long!"
      },
      "pk": [
        "id"
      ],
      "unique": [],
      "indexes": [
        [
          "status"
        ],
        [
          "name"
        ]
      ],
      "checks": []
    },
    "supplier_products": {
      "name": "supplier_products",
      "cls": "SupplierProduct",
      "module": "supplier",
      "fields": {
        "supplier_id": "ref:suppliers!",
        "product_id": "ref:products!",
        "supplier_item_code": "str:80",
        "active": "bool!"
      },
      "pk": [
        "supplier_id",
        "product_id"
      ],
      "unique": [],
      "indexes": [
        [
          "product_id"
        ]
      ],
      "checks": []
    },
    "supplier_status_requests": {
      "name": "supplier_status_requests",
      "cls": "SupplierStatusRequest",
      "module": "supplier",
      "fields": {
        "id": "uuid!",
        "supplier_id": "ref:suppliers!",
        "from_status": "enum:SupplierStatus!",
        "to_status": "enum:SupplierStatus!",
        "reason": "text!",
        "requested_by_id": "ref:users!",
        "requested_at": "instant!",
        "state": "enum:DecisionState!",
        "decided_by_id": "ref:users",
        "decided_at": "instant",
        "decision_comment": "text"
      },
      "pk": [
        "id"
      ],
      "unique": [],
      "indexes": [
        [
          "supplier_id",
          "requested_at"
        ]
      ],
      "checks": [
        "from_status <> to_status",
        "requested_by_id IS DISTINCT FROM decided_by_id",
        "(state = 'PENDING' AND decided_by_id IS NULL AND decided_at IS NULL) OR (state IN ('APPROVED','REJECTED') AND decided_by_id IS NOT NULL AND decided_at IS NOT NULL)"
      ]
    },
    "contracts": {
      "name": "contracts",
      "cls": "Contract",
      "module": "contract",
      "fields": {
        "id": "uuid!",
        "supplier_id": "ref:suppliers!",
        "state": "enum:ContractState!",
        "current_registered_version_id": "ref:contract_versions",
        "created_by_id": "ref:users!",
        "created_at": "instant!",
        "lock_version": "long!"
      },
      "pk": [
        "id"
      ],
      "unique": [],
      "indexes": [
        [
          "supplier_id",
          "state"
        ]
      ],
      "checks": []
    },
    "contract_versions": {
      "name": "contract_versions",
      "cls": "ContractVersion",
      "module": "contract",
      "fields": {
        "id": "uuid!",
        "contract_id": "ref:contracts!",
        "version_no": "int!",
        "number": "str:100!",
        "signed_on": "date",
        "valid_from": "date!",
        "valid_to": "date!",
        "terms": "text!",
        "change_reason": "text",
        "state": "enum:VersionState!",
        "created_by_id": "ref:users!",
        "created_at": "instant!",
        "decided_by_id": "ref:users",
        "decided_at": "instant",
        "decision_comment": "text"
      },
      "pk": [
        "id"
      ],
      "unique": [
        [
          "contract_id",
          "version_no"
        ],
        [
          "id",
          "contract_id"
        ]
      ],
      "indexes": [],
      "checks": [
        "version_no > 0",
        "valid_from <= valid_to",
        "created_by_id IS DISTINCT FROM decided_by_id",
        "(state IN ('DRAFT','PENDING') AND decided_by_id IS NULL AND decided_at IS NULL) OR (state IN ('APPROVED','REJECTED') AND decided_by_id IS NOT NULL AND decided_at IS NOT NULL)"
      ]
    },
    "purchase_orders": {
      "name": "purchase_orders",
