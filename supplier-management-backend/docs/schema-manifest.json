{
  "schema_version": 2,
  "tables": {
    "users": {
      "name": "users",
      "cls": "User",
      "module": "auth",
      "fields": {
        "id": "uuid!",
        "login": "str:80!",
        "password_hash": "str:255!",
        "display_name": "str:200!",
        "status": "enum:UserStatus!",
        "failed_login_count": "int!",
        "locked_until": "instant",
        "created_at": "instant!",
        "updated_at": "instant!",
        "lock_version": "long!"
      },
      "pk": [
        "id"
      ],
      "unique": [
        [
          "login"
        ]
      ],
      "indexes": [],
      "checks": [
        "failed_login_count >= 0"
      ]
    },
    "user_role_assignments": {
      "name": "user_role_assignments",
      "cls": "UserRoleAssignment",
      "module": "auth",
      "fields": {
        "id": "uuid!",
        "user_id": "ref:users!",
        "role_code": "enum:RoleCode!",
        "assigned_by_id": "ref:users!",
        "assigned_at": "instant!",
        "revoked_at": "instant"
      },
      "pk": [
        "id"
      ],
      "unique": [],
      "indexes": [
        [
          "user_id"
        ],
        [
          "assigned_at"
        ]
      ],
      "checks": [
        "revoked_at IS NULL OR revoked_at >= assigned_at"
      ]
    },
    "auth_sessions": {
      "name": "auth_sessions",
      "cls": "AuthSession",
      "module": "auth",
      "fields": {
        "id": "uuid!",
        "user_id": "ref:users!",
        "refresh_token_hash": "str:128!",
        "token_generation": "long!",
        "created_at": "instant!",
        "expires_at": "instant!",
        "revoked_at": "instant",
        "rotated_at": "instant",
        "lock_version": "long!"
      },
      "pk": [
        "id"
      ],
      "unique": [
        [
          "refresh_token_hash"
        ]
      ],
      "indexes": [
        [
          "user_id"
        ],
        [
          "expires_at"
        ]
      ],
      "checks": [
        "token_generation >= 0",
        "expires_at > created_at"
      ]
    },
    "product_categories": {
      "name": "product_categories",
      "cls": "ProductCategory",
      "module": "catalog",
      "fields": {
        "id": "uuid!",
        "code": "str:50!",
