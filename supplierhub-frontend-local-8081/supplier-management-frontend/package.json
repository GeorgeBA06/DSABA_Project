{
  "name": "supplier-management-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test:contracts": "node tools/test-scenarios.mjs && node tools/check-contract.mjs && node tools/check-complete-api.mjs",
    "test:http-client": "node tools/test-api-client.mjs",
    "test:offline": "npm run test:contracts && npm run test:http-client",
    "test:live": "node tools/live-smoke.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
